# =============================================================================
# Pushsidian Web — Environment Variables
# =============================================================================
# Copy this file to web/.env and fill in your values.
#
# Get Clerk keys: https://dashboard.clerk.com → your app → API keys
# =============================================================================

# Clerk frontend key (must start with VITE_ for Vite to expose it)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...

# Backend API URL (dev proxy handles /api, but useful for direct API calls)
VITE_API_URL=http://localhost:3000
