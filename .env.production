# =============================================================================
# Pushsidian — Production Environment
# =============================================================================
# Copy this to .env in Railway dashboard, fill in your actual values.
# =============================================================================

NODE_ENV=production
PORT=8080

# Your Railway app domain (or custom domain)
APP_BASE_URL=https://pushsidian.up.railway.app

# Postgres — Railway provides this automatically as DATABASE_URL
DATABASE_URL=${{Postgres.DATABASE_URL}}

# Clerk Production keys — get from https://dashboard.clerk.com
# Switch to "Production" environment in Clerk dashboard
CLERK_PUBLISHABLE_KEY=pk_live_...
CLERK_SECRET_KEY=sk_live_...
CLERK_WEBHOOK_SECRET=whsec_...

# Cloudflare R2 — create a production bucket + API token
AWS_ACCESS_KEY_ID=...
AWS_SECRET_ACCESS_KEY=...
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_BUCKET=pushsidian-prod
S3_REGION=auto
S3_FORCE_PATH_STYLE=false

# AI providers
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# Slack bot token for DMs
# Create app at https://api.slack.com/apps
# Scopes: chat:write, users:read, users:read.email
SLACK_BOT_TOKEN=xoxb-...

# CORS — your web app domain (same as APP_BASE_URL)
CORS_ORIGINS=https://pushsidian.up.railway.app,app://obsidian.md
