# =============================================================================
# Pushsidian — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values.
# Do NOT commit .env to git.
#
# How to get the values:
#   - Clerk: https://dashboard.clerk.com → your app → API keys
#   - Neon Postgres: https://neon.tech → create project → connection string
#   - Cloudflare R2: https://dash.cloudflare.com → R2 → Manage R2 API tokens
#   - OpenAI: https://platform.openai.com → API keys
#   - Anthropic: https://console.anthropic.com → API keys
# =============================================================================

# -----------------------------------------------------------------------------
# API SERVICE (api/)
# -----------------------------------------------------------------------------

# Postgres connection string (Neon for prod, local Docker for dev)
# Dev example: postgres://pushsidian:pushsidian@localhost:5432/pushsidian
DATABASE_URL=

# Clerk — backend verification
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
CLERK_WEBHOOK_SECRET=whsec_...

# S3-compatible storage (Cloudflare R2 for prod, MinIO for dev)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_ENDPOINT=
S3_BUCKET=pushsidian
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=false

# AI providers
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# API port (Fly.io expects 8080)
PORT=3000

# -----------------------------------------------------------------------------
# WEB APP (web/)
# -----------------------------------------------------------------------------

# Clerk — frontend publishable key (same as CLERK_PUBLISHABLE_KEY above)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...

# Backend API URL (local dev proxy handles /api, but useful for direct calls)
VITE_API_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# OBSIDIAN PLUGIN
# -----------------------------------------------------------------------------
# These are NOT environment variables — the user enters them in the plugin
# settings tab inside Obsidian:
#
#   API Key       → generate in web app Profile page (long-lived token)
#   API Base URL  → https://api.pushsidian.com (prod) or http://localhost:3000 (dev)
#   Organization  → org_... (shown in web app Team Settings)
# =============================================================================
