# =============================================================================
# Pushsidian API — Environment Variables
# =============================================================================
# Copy this file to api/.env and fill in your values.
#
# Get Clerk keys: https://dashboard.clerk.com → your app → API keys
# Get Neon DB URL: https://neon.tech → create project → connection string
# Get R2 tokens: https://dash.cloudflare.com → R2 → Manage R2 API tokens
# Get OpenAI key: https://platform.openai.com → API keys
# Get Anthropic key: https://console.anthropic.com → API keys
# =============================================================================

# Postgres (Neon for prod, local Docker for dev)
DATABASE_URL=postgres://pushsidian:pushsidian@localhost:5432/pushsidian

# Clerk (backend)
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
CLERK_WEBHOOK_SECRET=whsec_...

# S3-compatible storage (Cloudflare R2 for prod, MinIO for dev)
AWS_ACCESS_KEY_ID=minio
AWS_SECRET_ACCESS_KEY=pushsidian123
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=pushsidian
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true

# AI providers
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# Server port (Fly.io expects 8080)
PORT=3000
