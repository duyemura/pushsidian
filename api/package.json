{
  "name": "@pushsidian/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/app.ts",
    "build": "tsc",
    "start": "node dist/app.js",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:generate": "kysely-codegen --dialect postgres --out-file src/db/generated-types.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.600.0",
    "@aws-sdk/s3-request-presigner": "^3.600.0",
    "@clerk/backend": "^3.4.12",
    "@clerk/fastify": "^3.1.29",
    "@fastify/cors": "^10.1.0",
    "@fastify/static": "^9.1.3",
    "@fastify/swagger": "^9.0.0",
    "@fastify/swagger-ui": "^5.0.0",
    "@pushsidian/shared-types": "workspace:*",
    "@types/marked": "^6.0.0",
    "dotenv": "^17.4.2",
    "fastify": "^5.0.0",
    "fastify-plugin": "^5.0.0",
    "fastify-type-provider-zod": "^6.1.0",
    "kysely": "^0.27.0",
    "marked": "^18.0.4",
    "pg": "^8.12.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "^20.0.0",
    "@types/pg": "^8.11.0",
    "eslint": "^8.0.0",
    "kysely-codegen": "^0.16.0",
    "tsx": "^4.0.0",
    "typescript": "^5.9.0"
  }
}
